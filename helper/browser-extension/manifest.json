{
  "manifest_version": 3,
  "name": "Plane Radar Deck",
  "version": "1.1.0",
  "description": "YouTube Music sırasını Plane Radar kartına gösterir; kartın tuşları açık sekmeye geçer.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://music.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "ytmusic.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Plane Radar Deck",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  }
}